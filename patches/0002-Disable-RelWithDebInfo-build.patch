From a2c1d059f5c0a4e9619e79f94656754dfd50f687 Mon Sep 17 00:00:00 2001
From: James Green <green@ms1p.org>
Date: Wed, 4 Nov 2026 17:41:35 +0100
Subject: [PATCH] Disable RelWithDebInfo build

- Don't do this automatically
---
 config/CMakeLists.txt | 24 +++++++++++++-----------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/config/CMakeLists.txt b/config/CMakeLists.txt
index db89f17..b432c3d 100644
--- a/config/CMakeLists.txt
+++ b/config/CMakeLists.txt
@@ -51,17 +51,19 @@ if(
 endif()
 
 # Set build type as CMake does not provide defaults
-if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
-  set(
-    CMAKE_BUILD_TYPE "RelWithDebInfo"
-    CACHE STRING "Build type to be used."
-    FORCE
-  )
-  message(
-    STATUS
-    "Setting build type to '${CMAKE_BUILD_TYPE}' as none was specified."
-  )
-endif()
+# JAG 28/02/25: Don't do this, will set the CMAKE_BUILD_TYPE 
+# to RelWithDebInfo for FHI-aims and add additional flags.
+#if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
+#  set(
+#    CMAKE_BUILD_TYPE "RelWithDebInfo"
+#    CACHE STRING "Build type to be used."
+#    FORCE
+#  )
+#  message(
+#    STATUS
+#    "Setting build type to '${CMAKE_BUILD_TYPE}' as none was specified."
+#  )
+#endif()
 
 include(CMakePackageConfigHelpers)
 configure_package_config_file(
